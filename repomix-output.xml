:root {
  --wb-purple: #cb11ab;
  --gradient-primary: linear-gradient(135deg, #cb11ab 0%, #ff33c4 100%);
  --bg-gray: #f4f6f8; /* Более мягкий современный фон */
  --text-main: #1f2937;
  --text-muted: #6b7280;
  --card-radius: 20px; /* Более округлые углы */
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  /* Новый шрифт Inter */
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

body {
  background-color: var(--bg-gray);
  color: var(--text-main);
  -webkit-font-smoothing: antialiased;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

/* --- Шапка (Navbar) --- */
.nav {
  background: var(--gradient-primary); /* Градиент в шапке */
  padding: 15px 0;
  margin-bottom: 30px;
  box-shadow: 0 4px 20px rgba(203, 17, 171, 0.2);
}

.nav-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.nav-logo {
  font-size: 26px;
  font-weight: 800;
  color: white;
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 12px;
  letter-spacing: -0.5px;
}

/* Значок возле логотипа */
.logo-icon {
  background: white;
  border-radius: 50%;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  transition: transform 0.3s ease;
}

.nav-logo:hover .logo-icon {
  transform: rotate(-10deg) scale(1.1);
}

.nav-links {
  display: flex;
  gap: 25px;
  align-items: center;
}

.nav-links a, .nav-links button {
  color: white;
  text-decoration: none;
  font-size: 13px;
  font-weight: 500;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  background: none;
  border: none;
  cursor: pointer;
  transition: opacity 0.2s, transform 0.2s;
}

.nav-links a:hover, .nav-links button:hover {
  opacity: 0.8;
  transform: translateY(-2px);
}

/* --- Каталог и карточки товаров --- */
.catalog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 25px;
  padding-bottom: 40px;
}

.product-card {
  background: white;
  border-radius: var(--card-radius);
  padding: 15px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  /* Мягкая современная тень */
  box-shadow: 0 4px 6px rgba(0,0,0,0.02), 0 10px 15px -3px rgba(0,0,0,0.03);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid rgba(255, 255, 255, 0.8);
}

.product-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 25px -5px rgba(0,0,0,0.08), 0 10px 10px -5px rgba(0,0,0,0.04);
}

.product-image-placeholder {
  width: 100%;
  aspect-ratio: 3/4;
  background-color: #f8f9fc;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.product-price {
  font-size: 24px;
  font-weight: 800;
  color: var(--text-main);
}

.product-title {
  font-size: 15px;
  color: var(--text-main);
  line-height: 1.5;
  flex-grow: 1;
}

/* --- Кнопки и формы --- */
.btn-primary {
  background: var(--gradient-primary);
  color: white;
  border: none;
  padding: 14px;
  border-radius: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s;
  width: 100%;
  font-size: 15px;
}

.btn-primary:hover:not(:disabled) {
  transform: scale(1.02);
  box-shadow: 0 8px 20px rgba(203, 17, 171, 0.3);
  filter: brightness(1.1);
}

.btn-primary:disabled {
  background: #cbd5e1;
  color: #64748b;
  cursor: not-allowed;
  box-shadow: none;
}

.card {
  background: white;
  padding: 40px;
  border-radius: var(--card-radius);
  max-width: 400px;
  margin: 40px auto;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

.input-field {
  width: 100%;
  padding: 14px 18px;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  margin-bottom: 15px;
  font-size: 16px;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.input-field:focus {
  border-color: var(--wb-purple);
  box-shadow: 0 0 0 3px rgba(203, 17, 171, 0.1);
}

/* --- Анимация поиска (Эффект стекла) --- */
.search-form {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px); /* Эффект матового стекла */
  border-radius: 24px;
  transition: background-color 0.3s ease, box-shadow 0.3s ease;
  margin: 0 15px;
}

.search-form.active {
  background-color: white;
  box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.search-btn {
  background: none;
  border: none;
  font-size: 20px;
  padding: 10px 15px;
  cursor: pointer;
  color: white;
  transition: color 0.3s ease;
}

.search-form.active .search-btn {
  color: var(--wb-purple);
}

.nav-search {
  width: 0;
  padding: 0;
  border: none;
  outline: none;
  background: transparent;
  color: var(--text-main);
  font-size: 15px;
  font-weight: 500;
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1), padding 0.4s ease;
}

.nav-search.expanded {
  width: 280px;
  padding: 10px 20px 10px 0;
}
</file>

